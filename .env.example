# Copy to .env.local for local Flutter runs. Do not commit that file.
# Use environment-specific Supabase variables with APP_ENV (local, staging, production).
APP_ENV=local
SUPABASE_URL_LOCAL=<local-supabase-url>
SUPABASE_ANON_KEY_LOCAL=<local-supabase-anon-key>
SUPABASE_URL_STAGING=<staging-supabase-url>
SUPABASE_ANON_KEY_STAGING=<staging-supabase-anon-key>
SUPABASE_URL_PRODUCTION=<production-supabase-url>
SUPABASE_ANON_KEY_PRODUCTION=<production-supabase-anon-key>

# Used by public_recipe_sync during local Edge Function development.
FOOD_API_BASE_URL=<food-api-base-url>
FOOD_API_KEY=<food-api-key>
FOOD_API_URL_TEMPLATE=<food-api-url-template>
PUBLIC_RECIPE_SYNC_WORKER_SECRET=<local-worker-secret>
